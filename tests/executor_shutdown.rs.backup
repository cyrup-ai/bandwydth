//! Test executor shutdown functionality

use lib_bandwydth::concurrent::executor::{spawn_executor, Task};
use lib_bandwydth::action::Action;
use crossbeam_channel::unbounded;
use std::time::Duration;

#[test]
fn test_shutdown_via_task() {
    // Create action channel
    let (action_tx, action_rx) = unbounded();
    
    // Spawn executor
    let handle = spawn_executor(action_tx);
    
    // Test that shutdown_via_task works correctly
    let result = handle.shutdown_via_task();
    assert!(result.is_ok(), "Shutdown via task should succeed");
    
    // Verify that the action is received
    let received_action = action_rx.recv_timeout(Duration::from_millis(100));
    assert!(received_action.is_ok(), "Should receive quit action");
    
    if let Ok(Action::Quit) = received_action {
        // Expected behavior - executor sends Quit action when receiving Shutdown task
    } else {
        panic!("Expected Action::Quit, got: {:?}", received_action);
    }
}

#[test]
fn test_task_shutdown_variant_construction() {
    // This test simply demonstrates that Task::Shutdown can be constructed
    let shutdown_task = Task::Shutdown;
    
    // Verify it matches correctly
    match shutdown_task {
        Task::Shutdown => {
            // Expected - variant constructs correctly
        }
        _ => panic!("Task::Shutdown variant not constructed correctly"),
    }
}